<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard — StockFolio</title>
  <link rel="stylesheet" href="css/style.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

<nav class="navbar">
  <div class="nav-brand">
    <span class="brand-icon">◈</span>
    <span class="brand-name">StockFolio</span>
  </div>
  <div class="nav-links">
    <a href="index.html" class="nav-link">Portfolio</a>
    <a href="dashboard.html" class="nav-link active">Dashboard</a>
  </div>
  <div class="nav-meta">
    <span class="last-updated" id="lastUpdated">—</span>
    <button class="refresh-btn" id="refreshBtn" title="Ververs koersen">⟳</button>
  </div>
</nav>

<main class="main-content">

  <!-- Search Section -->
  <section class="search-section">
    <div class="search-header">
      <h1 class="page-title">Aandeel toevoegen</h1>
      <p class="page-subtitle">Zoek op naam of tickersymbool om een positie toe te voegen aan je portfolio.</p>
    </div>
    <div class="search-bar-wrapper">
      <span class="search-icon">⌕</span>
      <input
        type="text"
        id="searchInput"
        class="search-input"
        placeholder="Bijv. AAPL, MSFT, VWRL, iShares…"
        autocomplete="off"
      />
      <button class="search-clear" id="searchClear" style="display:none">✕</button>
    </div>
    <div class="search-results" id="searchResults"></div>
  </section>

  <!-- Add Position Modal / Inline Form -->
  <div class="add-form-overlay" id="addFormOverlay" style="display:none">
    <div class="add-form-card">
      <div class="add-form-header">
        <div>
          <span class="add-form-symbol" id="formSymbol">—</span>
          <span class="add-form-name" id="formName">—</span>
        </div>
        <button class="close-btn" id="closeForm">✕</button>
      </div>
      <div class="add-form-price-row">
        <span class="add-form-label">Huidige koers</span>
        <span class="add-form-current-price" id="formCurrentPrice">—</span>
      </div>
      <div class="form-fields">
        <div class="form-group">
          <label class="form-label" for="inputShares">Aantal aandelen</label>
          <input type="number" id="inputShares" class="form-input" placeholder="0" min="0" step="0.001" />
        </div>
        <div class="form-group">
          <label class="form-label" for="inputAvgPrice">Gemiddelde aankoopprijs (€)</label>
          <input type="number" id="inputAvgPrice" class="form-input" placeholder="0.00" min="0" step="0.01" />
          <span class="form-hint">Vul de gemiddelde prijs in die je hebt betaald per aandeel.</span>
        </div>
        <div class="form-group">
          <label class="form-label" for="inputCurrency">Valuta aankoopprijs</label>
          <select id="inputCurrency" class="form-input form-select">
            <option value="EUR">EUR — Euro</option>
            <option value="USD">USD — Amerikaanse dollar</option>
            <option value="GBP">GBP — Brits pond</option>
          </select>
        </div>
      </div>
      <div class="form-preview" id="formPreview" style="display:none">
        <div class="preview-row">
          <span>Totale aankoopwaarde</span>
          <span id="previewCost">—</span>
        </div>
        <div class="preview-row">
          <span>Huidige waarde</span>
          <span id="previewValue">—</span>
        </div>
        <div class="preview-row highlight">
          <span>Verwachte winst/verlies</span>
          <span id="previewGain">—</span>
        </div>
      </div>
      <div class="form-actions">
        <button class="btn-secondary" id="cancelForm">Annuleren</button>
        <button class="btn-primary" id="confirmAdd">Toevoegen aan portfolio</button>
      </div>
    </div>
  </div>

  <!-- Current Holdings on Dashboard -->
  <section class="holdings-section" id="dashboardHoldings">
    <div class="section-header">
      <h2 class="section-title">Huidige posities</h2>
      <button class="btn-danger-small" id="clearAllBtn" style="display:none">Alles verwijderen</button>
    </div>
    <div class="empty-state-small" id="noHoldingsMsg">
      <p>Nog geen posities. Zoek hierboven naar aandelen om te beginnen.</p>
    </div>
    <div class="dashboard-holdings-grid" id="dashboardHoldingsGrid"></div>
  </section>

</main>

<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
  <div class="loader-ring"></div>
  <p>Koersen ophalen…</p>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script src="js/storage.js"></script>
<script src="js/api.js"></script>
<script src="js/dashboard.js"></script>
</body>
</html>
